#version 450
#extension GL_GOOGLE_include_directive : require
#include "blend.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, set = 0, binding = 0) readonly buffer First { uint a_px[]; };
layout(std430, set = 0, binding = 1) readonly buffer Second { uint b_px[]; };
layout(std430, set = 1, binding = 0) buffer Out { uint out_px[]; };
layout(std140, set = 2, binding = 0) uniform Params { uvec4 info; }; // width, height, ratio, alpha

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= info.x || p.y >= info.y) return;
    uint i = p.y * info.x + p.x;
    out_px[i] = crossfade_pixel(a_px[i], b_px[i], info.z, info.w != 0u);
}
