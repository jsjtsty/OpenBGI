#version 450
#extension GL_GOOGLE_include_directive : require
#include "blend.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, set = 0, binding = 0) readonly buffer First { uint a_px[]; };
layout(std430, set = 0, binding = 1) readonly buffer Second { uint b_px[]; };
layout(std430, set = 1, binding = 0) buffer Out { uint out_px[]; };
layout(std140, set = 2, binding = 0) uniform Params { uvec4 info; }; // width, height, ratio, alpha

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= info.x || p.y >= info.y) return;
    uint i = p.y * info.x + p.x;
    ivec4 a = px_unpack(a_px[i]), b = px_unpack(b_px[i]);
    int ratio = int(info.z);
    if (info.w == 0u) {
        out_px[i] = px_pack(clamp(a + (((b - a) * ratio) >> 8), 0, 255));
        return;
    }
    uint wa = uint(a.w) * (256u - info.z), wb = uint(b.w) * info.z;
    uint sum = (wa + wb) & 65535u;
    if (sum == 0u) { out_px[i] = 0u; return; }
    int w = int((wa << 7) / sum);
    ivec3 rgb = clamp(b.xyz + (((a.xyz - b.xyz) * w) >> 7), 0, 255);
    out_px[i] = px_pack(ivec4(rgb, int((sum >> 8) & 255u)));
}
